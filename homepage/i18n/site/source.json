 },
 {
  "id": "cf01481f62",
  "kind": "html",
  "text": "Privacy"
 },
 {
  "id": "df20980a9a",
  "kind": "html",
  "text": "Everything runs in your browser. Sign in once with Google; your name and email stay on your device, and nothing is sent to a server. This website sets no cookies. Details: ⟨0⟩privacy policy⟨/0⟩."
