  "text": "Language"
 },
 {
  "id": "4ff37f868e",
  "kind": "attr",
  "text": "Huescribe is a Chrome extension that turns any website’s design into an AI prompt for vibe coding."
 },
 {
  "id": "10ac2b72be",
  "kind": "attr",
  "text": "How to turn a website design you like into an AI prompt"
 },
 {
  "id": "8a1b654587",
  "kind": "attr",
  "text": "Pick parts of any website with the Huescribe Chrome extension and paste them into your AI app as one prompt."
 },
 {
  "id": "d47509d600",
  "kind": "attr",
  "text": "Google Chrome with the Huescribe extension"
 },
 {
  "id": "7f59f9facb",
  "kind": "attr",
  "text": "An AI app such as Claude Code, Cursor, Lovable, v0 or Bolt"
 },
 {
  "id": "7762902d04",
  "kind": "attr",
  "text": "Click what you like"
 },
 {
  "id": "e113358c03",
  "kind": "attr",
  "text": "Open the Huescribe panel on any site and click a button, a card or a whole section."
 },
 {
  "id": "d9b6b1c67b",
  "kind": "attr",
  "text": "Choose what to take"
 },
 {
  "id": "54e8f2c930",
  "kind": "attr",
  "text": "Turn on colors, fonts, layout or motion. Your site keeps the rest."
 },
 {
  "id": "e125d0380f",
  "kind": "attr",
  "text": "Paste the prompt"
 },
 {
  "id": "735753d1bc",
  "kind": "attr",
  "text": "Copy one prompt for everything you picked and paste it into your AI app."
 },
 {
  "id": "a794a07107",
  "kind": "attr",
  "text": "Pick any part of a website: a section, a button, a hover effect or an animation"
 },
 {
  "id": "6c19bbab53",
  "kind": "attr",
  "text": "Choose what to take: color palette, fonts and typography, layout and spacing, or motion"
 },
 {
  "id": "b9d97fdffb",
  "kind": "attr",
  "text": "Writes one design prompt for Claude Code, Cursor, ChatGPT, Gemini, Claude, Windsurf, Copilot, Lovable, v0 or Bolt"
 },
 {
